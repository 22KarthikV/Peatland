# Build from the repo root: docker build -f api/Dockerfile.worker .
# The worker runs the real pipeline (pipeline/) and the NDVI baseline (ml/), so both workspace
# packages are installed through the api `worker` extra (editable, so ml/pipeline find
# /app/contracts by walking up from their sources).
FROM python:3.13-slim

# The rasterio wheel bundles GDAL but links the system libexpat, which slim images lack.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 \
    QUEUE_SCHEMA_PATH=/app/contracts/queue.schema.json \
    # GDAL (rasterio) reads public Earth Search / Copernicus DEM COGs anonymously over the
    # network; worker products go through boto3, which ignores these settings.
    AWS_NO_SIGN_REQUEST=YES \
    GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR \
    CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.TIF,.tiff \
    GDAL_HTTP_MAX_RETRY=5 GDAL_HTTP_RETRY_DELAY=2 \
    VSI_CACHE=TRUE

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY api/pyproject.toml api/pyproject.toml
COPY pipeline/pyproject.toml pipeline/pyproject.toml
COPY ml/pyproject.toml ml/pyproject.toml
# Dependencies first for layer caching (third-party only).
RUN mkdir -p api/src/api pipeline/src/pipeline ml/src/ml \
    && uv sync --frozen --no-dev --package peatwatch-api --extra worker --no-install-workspace
COPY contracts contracts
COPY pipeline/src pipeline/src
COPY ml/src ml/src
COPY api/src api/src
RUN uv sync --frozen --no-dev --package peatwatch-api --extra worker

RUN useradd --system --no-create-home app
USER app
CMD ["python", "-m", "api.worker"]
